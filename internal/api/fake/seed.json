  "policy": "// Fathom demo tailnet policy (HuJSON: comments and trailing commas allowed).\n{\n  // People, by role.\n  \"groups\": {\n    \"group:admins\": [\"alice@\", \"ops@\"],\n    \"group:devs\":   [\"bob@\", \"carol@\"],\n  },\n\n  // Who may assign which tags.\n  \"tagOwners\": {\n    \"tag:server\":     [\"group:admins\"],\n    \"tag:k8s\":        [\"group:admins\"],\n    \"tag:dns\":        [\"group:admins\"],\n    \"tag:router\":     [\"group:admins\"],\n    \"tag:exit\":       [\"group:admins\"],\n    \"tag:storage\":    [\"group:admins\"],\n    \"tag:db\":         [\"group:admins\"],\n    \"tag:monitoring\": [\"group:admins\"],\n    \"tag:ci\":         [\"group:admins\", \"group:devs\"],\n    \"tag:iot\":        [\"group:admins\"],\n    \"tag:media\":      [\"group:admins\"],\n  },\n\n  // Routes and exit nodes that are approved automatically.\n  \"autoApprovers\": {\n    \"routes\": {\n      \"10.0.0.0/24\": [\"tag:router\"],\n    },\n    \"exitNode\": [\"tag:exit\"],\n  },\n\n  \"acls\": [\n    // Admins reach everything.\n    {\"action\": \"accept\", \"src\": [\"group:admins\"], \"dst\": [\"*:*\"]},\n    // Developers reach CI and monitoring, and their own devices.\n    {\"action\": \"accept\", \"src\": [\"group:devs\"], \"dst\": [\"tag:ci:*\", \"tag:monitoring:80,443,3000\"]},\n    {\"action\": \"accept\", \"src\": [\"autogroup:member\"], \"dst\": [\"autogroup:self:*\"]},\n    // Everyone may resolve DNS through the pi-holes.\n    {\"action\": \"accept\", \"src\": [\"*\"], \"dst\": [\"tag:dns:53\"]},\n    // The lab subnet behind the HA routers.\n    {\"action\": \"accept\", \"src\": [\"group:admins\", \"tag:k8s\"], \"dst\": [\"10.0.0.0/24:*\"]},\n  ],\n\n  \"ssh\": [\n    {\"action\": \"check\", \"src\": [\"group:admins\"], \"dst\": [\"tag:server\"], \"users\": [\"root\", \"autogroup:nonroot\"]},\n  ],\n}\n",
