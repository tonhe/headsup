// Demo tailnet policy (HuJSON: comments and trailing commas are fine).
{
  "groups": {
    "group:admins": ["alice@"],
    "group:dev":    ["bob@", "carol@"],
  },
  "tagOwners": {
    "tag:router": ["group:admins"],
    "tag:server": ["group:admins"],
  },
  "autoApprovers": {
    "routes": {
      "10.0.0.0/24": ["tag:router"],
    },
    "exitNode": ["tag:router"],
  },
  "acls": [
    {"action": "accept", "src": ["group:admins"], "dst": ["*:*"]},
    {"action": "accept", "src": ["group:dev"], "dst": ["tag:server:22,443", "10.0.0.0/24:*"]},
  ],
  "ssh": [
    {"action": "check", "src": ["group:admins"], "dst": ["tag:server"], "users": ["root", "autogroup:nonroot"]},
  ],
}
